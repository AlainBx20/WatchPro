rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users full access to rooms and subcollections
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;
      
      match /chatMessages/{msgId} {
        allow read, write: if request.auth != null;
      }
      
      match /aiSummaries/{summaryId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
